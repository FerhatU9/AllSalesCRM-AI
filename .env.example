# LOCAL DEVELOPMENT ONLY. Copy to .env and replace placeholder with a random token.
# .env is gitignored. Never commit any real credentials.
API_APP_TOKEN=replace-with-a-random-32-byte-token
BACKEND_URL=http://127.0.0.1:8000
DIFY_BASE_URL=https://api.dify.ai/v1

# Dify *application* API keys; separate for the two published Chatflows.
# These are NOT direct Google Gemini or Anthropic provider keys.
DIFY_GEMINI_API_KEY=
DIFY_CLAUDE_API_KEY=
