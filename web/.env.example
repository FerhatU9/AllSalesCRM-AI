# Local development only. Never commit real secrets or tokens.
# Create a Regular Web Application in Auth0 and register an API for FastAPI.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=replace-with-auth0-app-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-app-client-secret
AUTH0_SECRET=replace-with-64-hex-characters
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.allsales.local

# Used by Next.js server only. Never use NEXT_PUBLIC_ for authentication secrets.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
